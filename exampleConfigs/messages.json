{
  "headers": [
    {
      "type": "basic",
      "start_bytes": "AA55",
      "endianness": "little",
      "header_size": 4,
      "fields": [
        { "name": "msg_id", "type": "uint8", "byte_offset": 2 },
        { "name": "length", "type": "uint8", "byte_offset": 3 }
      ]
    },
    {
      "type": "extended",
      "start_bytes": "55AA",
      "endianness": "little",
      "header_size": 7,
      "fields": [
        { "name": "msg_id", "type": "uint16", "byte_offset": 2 },
        { "name": "length", "type": "uint16", "byte_offset": 4 },
        { "name": "version", "type": "uint8", "byte_offset": 6 }
      ]
    }
  ],

  "messages": [
    {
      "message_id": 1,
      "header": "basic",
      "name": "Heartbeat",
      "endianness": "little",
      "fields": [
        { "name": "timestamp", "type": "uint32", "byte_offset": 0, "endianness": "big" },
        { "name": "status", "type": "uint8", "byte_offset": 4 }
      ]
    },
    {
      "message_id": 2,
      "header": "basic",
      "name": "Vector",
      "endianness": "little",
      "fields": [
        {
          "name": "position",
          "type": "uint16",
          "byte_offset": 0,
          "array_length": 3
        }
      ]
    },
    {
      "message_id": 3,
      "header": "basic",
      "name": "DynamicPayload",
      "endianness": "little",
      "fields": [
        { "name": "count", "type": "uint8", "byte_offset": 0 },
        {
          "name": "values",
          "type": "uint16",
          "byte_offset": 1,
          "endianness": "big",
          "array_length_field": "count"
        }
      ]
    },
    {
      "message_id": 4,
      "header": "basic",
      "name": "ComposeMessage",
      "endianness": "little",
      "fields": [
        { "name": "timestamp", "type": "uint32", "byte_offset": 0, "endianness": "big" },
        { "name": "status", "type": "uint8", "byte_offset": 4 },
		{ "name": "position", "type": "uint16", "byte_offset": 5, "array_length": 3 }
      ]
    }
  ],

  "reactions": [
    {
      "type": "periodic_sender",
	  "sources": [
	    {
		  "message": "Heartbeat",
		  "receiver": "telemetry_udp_in",
		  "timeout_ms": 10000,
		  "default_values": {
			"timestamp": 123456,
			"status": 8
		  }
	    },
		{
		  "message": "Vector",
		  "receiver": "telemetry_udp_in",
		  "timeout_ms": 10000,
		  "default_values": {
			"position": [0, 0, 0]
		  }
		}
	  ],
      "response": "ComposeMessage",
      "sender": "telemetry_udp_out",
      "period_ms": 1000,
      "on_timeout": "stop"
    }
  ]
}