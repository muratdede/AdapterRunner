{
  "headers": [
    {
      "type": "basic",
      "endianness": "little",
      "header_size": 4,
      "fields": [
        {
          "name": "start_bytes",
          "type": "uint16",
          "byte_offset": 0,
          "identifier": true,
          "match_values": [
            "AA55"
          ]
        },
        {
          "name": "msg_id",
          "type": "uint8",
          "byte_offset": 2
        },
        {
          "name": "length",
          "type": "uint8",
          "byte_offset": 3
        }
      ]
    },
    {
      "type": "extended",
      "endianness": "little",
      "header_size": 7,
      "fields": [
        {
          "name": "start_bytes",
          "type": "uint16",
          "byte_offset": 0,
          "identifier": true,
          "match_values": [
            "55AA"
          ]
        },
        {
          "name": "msg_id",
          "type": "uint16",
          "byte_offset": 2
        },
        {
          "name": "length",
          "type": "uint16",
          "byte_offset": 4
        },
        {
          "name": "version",
          "type": "uint8",
          "byte_offset": 6
        }
      ]
    }
  ],
  "messages": [
    {
      "message_id": 1,
      "header": "basic",
      "name": "Heartbeat",
      "endianness": "little",
      "fields": [
        {
          "name": "timestamp",
          "type": "uint32",
          "endianness": "big"
        },
        {
          "name": "status",
          "type": "uint8"
        },
        {
          "name": "checksum",
          "type": "uint8",
          "compute": {
            "algorithm": "checksum_2c",
            "onMismatch": "drop"
          }
        }
      ]
    },
    {
      "message_id": 2,
      "header": "basic",
      "name": "Vector",
      "endianness": "little",
      "fields": [
        {
          "name": "position",
          "type": "float",
          "array_length": 3
        }
      ]
    },
    {
      "message_id": 3,
      "header": "basic",
      "name": "DynamicPayload",
      "endianness": "little",
      "fields": [
        {
          "name": "count",
          "type": "uint8"
        },
        {
          "name": "values",
          "type": "uint16",
          "endianness": "big",
          "array_length_field": "count"
        },
        {
          "name": "checksum",
          "type": "uint8",
          "compute": {
            "algorithm": "checksum_2c",
            "onMismatch": "drop"
          }
        }
      ]
    },
    {
      "message_id": 4,
      "header": "basic",
      "name": "ComposeMessage",
      "endianness": "little",
      "fields": [
        {
          "name": "timestamp",
          "type": "uint32",
          "endianness": "big"
        },
        {
          "name": "status",
          "type": "uint8"
        },
        {
          "name": "position",
          "type": "uint16",
          "array_length": 3
        },
        {
          "name": "checksum",
          "type": "uint8",
          "compute": {
            "algorithm": "checksum_2c",
            "onMismatch": "drop"
          }
        }
      ]
    }
  ],
  "reactions": [
    {
      "type": "periodic_sender",
      "sources": [
        {
          "message": "Heartbeat",
          "receiver": "telemetry_udp_in",
          "timeout_ms": 10000,
          "default_values": {
            "timestamp": 123456,
            "status": 8
          }
        },
        {
          "message": "Vector",
          "receiver": "telemetry_udp_in",
          "timeout_ms": 10000,
          "default_values": {
            "position": [
              0,
              0,
              0
            ]
          },
          "mappings": [
            {
              "to": "position",
              "expr": "position.map(x => int(x * 100))"
            }
          ]
        }
      ],
      "response": "ComposeMessage",
      "sender": "telemetry_udp_out",
      "period_ms": 1000,
      "on_timeout": "stop"
    }
  ]
}